---
// Import the global.scss file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/main.css';
import {SITE_TITLE} from '../consts';
import {getAlternatePath, getLang, withTrailingSlash} from '../i18n/utils';
import type {Lang} from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	image?: string;
	canonical?: string;
	alternates?: Partial<Record<Lang, string>>;
}

const {title, description, image = '/blog-placeholder-1.jpg', canonical, alternates} = Astro.props;
const lang = getLang(Astro.currentLocale);
const pathname = Astro.url.pathname;
const absolute = (path: string) => new URL(withTrailingSlash(path), Astro.site).href;

const canonicalURL = absolute(canonical ?? pathname);
const resolved = alternates ?? {fr: getAlternatePath(pathname, 'fr'), en: getAlternatePath(pathname, 'en')};
const alternateLinks = (Object.entries(resolved) as [Lang, string | undefined][])
	.filter((pair): pair is [Lang, string] => Boolean(pair[1]));
const ogLocale = {fr: 'fr_BE', en: 'en_US'} as const;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<!--
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
-->

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{alternateLinks.length > 1 && alternateLinks.map(([l, path]) => (
	<link rel="alternate" hreflang={l} href={absolute(path)} />
))}
{alternateLinks.length > 1 && resolved.fr && <link rel="alternate" hreflang="x-default" href={absolute(resolved.fr)} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:locale" content={ogLocale[lang]} />
{alternateLinks.filter(([l]) => l !== lang).map(([l]) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
