---
import {SITE_TITLE} from "../consts";
import HeaderLink from "./HeaderLink.astro";
const today = new Date();
---


<footer class="footer">
    <div class="wrapper wrapper--smaller footer__wrapper">
        <div class="footer__main">
            <div class="footer__main__primary">
                <a href="/" class="footer__main__primary__logo">
                	<span>
                    	{SITE_TITLE}
                	</span>
                    <svg viewBox="0 0 52 42" xmlns="http://www.w3.org/2000/svg">
                        <path d="M35.6606 0H51.1884V11.3981H35.6606V0ZM38.6606 3V8.3981H48.1884V3H38.6606Z"/>
                        <path d="M35.6606 0H51.1884V11.3981H35.6606V0ZM38.6606 3V8.3981H48.1884V3H38.6606Z"/>
                        <path d="M0 11.5V0H31.5V42H20V11.5H0Z"/>
                    </svg>
                </a>
                <nav class="footer__main__primary__menu">
                    <h2 class="hidden">Menu Principal</h2>
                    <ul class="footer__main__primary__menu__list">
                        <li class="footer__main__primary__menu__list__item">
                            <HeaderLink href="/" title="Accueil">Accueil</HeaderLink>
                        </li>
                        <li class="footer__main__primary__menu__list__item">
                            <HeaderLink href="/projets" title="Projets">Projets</HeaderLink>
                        </li>
                        <li class="footer__main__primary__menu__list__item">
                            <HeaderLink href="/apropos" title="A Propos">A Propos</HeaderLink>
                        </li>
                        <li class="footer__main__primary__menu__list__item">
                            <HeaderLink href="/#contact" title="Contact">Contact</HeaderLink>
                        </li>
                    </ul>
                </nav>
            </div>
            <div class="footer__main__secondary">
                <p class="footer__main__secondary__text">
                    Fait avec &#128155;, par Tom Cremer
                </p>
                <ul class="footer__main__secondary__list">
                    <li class="footer__main__secondary__list__item">
                        <a href="tel:+32499911975" title="Telephone" target="_blank" rel="noopener noreferrer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="lucide lucide-phone-icon lucide-phone">
                                <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/>
                            </svg>
                        </a>
                    </li>
                    <li class="footer__main__secondary__list__item">
                        <a href="mailto:contact@tomcremer.be" title="GitHub" target="_blank" rel="noopener noreferrer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="lucide lucide-mail-icon lucide-mail">
                                <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/>
                                <rect x="2" y="4" width="20" height="16" rx="2"/>
                            </svg>
                        </a>
                    </li>
                    <li class="footer__main__secondary__list__item">
                        <a href="https://github.com/tom-cremer" title="GitHub" target="_blank"
                           rel="noopener noreferrer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="lucide lucide-github-icon lucide-github">
                                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                                <path d="M9 18c-4.51 2-5-2-7-2"/>
                            </svg>
                        </a>
                    </li>
                    <li class="footer__main__secondary__list__item">
                        <a href="https://www.linkedin.com/in/tom-cremer/" title="LinkedIn" target="_blank"
                           rel="noopener noreferrer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="lucide lucide-linkedin-icon lucide-linkedin">
                                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                                <rect width="4" height="12" x="2" y="9"/>
                                <circle cx="4" cy="4" r="2"/>
                            </svg>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="footer__main__tertiary">
                <p class="footer__main__tertiary__copyright">&copy; {today.getFullYear()} Tom Cremer. All rights
                    reserved.</p>
            </div>
        </div>
    </div>
</footer>

