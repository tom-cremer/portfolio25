---
import type {Lang} from '../i18n/ui';

interface Props {
	date: Date;
	lang?: Lang;
}

const {date, lang = 'fr'} = Astro.props;
const locales = {fr: 'fr-FR', en: 'en-GB'} as const;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString(locales[lang], {year: 'numeric', month: 'long', day: 'numeric'})}
</time>
