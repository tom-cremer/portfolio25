---
import HeaderLink from './HeaderLink.astro';
import {SITE_TITLE} from '../consts';
---


<header class="header">
    <div class="wrapper wrapper--small">
        <div class="header__main">
            <a href="/" class="header__main__logo">
                <span>
                    {SITE_TITLE}
                </span>
                <svg viewBox="0 0 52 42" xmlns="http://www.w3.org/2000/svg">
                    <path d="M35.6606 0H51.1884V11.3981H35.6606V0ZM38.6606 3V8.3981H48.1884V3H38.6606Z"/>
                    <path d="M35.6606 0H51.1884V11.3981H35.6606V0ZM38.6606 3V8.3981H48.1884V3H38.6606Z"/>
                    <path d="M0 11.5V0H31.5V42H20V11.5H0Z"/>
                </svg>
            </a>
            <nav class="header__main__menu">
                <h2 class="hidden">Menu Principal</h2>
                <ul class="header__main__menu__list">
                    <li class="header__main__menu__list__item">
                        <HeaderLink href="/" title="Accueil">Accueil</HeaderLink>
                    </li>
                    <li class="header__main__menu__list__item">
                        <HeaderLink href="/projets" title="Projets">Projets</HeaderLink>
                    </li>
                    <li class="header__main__menu__list__item">
                        <HeaderLink href="/apropos" title="A Propos">A Propos</HeaderLink>
                    </li>
                </ul>
            </nav>
            <div class="header__main__contactContainer">
                <a href="https://github.com/tom-cremer" title="GitHub" target="_blank"
                   rel="noopener noreferrer" class="header__main__contactContainer__github">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="lucide lucide-github-icon lucide-github">
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                        <path d="M9 18c-4.51 2-5-2-7-2"/>
                    </svg>
                </a>
                <a href="/#contact" title="Contact" class="button header__main__contactContainer__contact">
                    Contact
                </a>
            </div>

            <input type="checkbox" id="menu-toggle" class="header__main__input"/>
            <label for="menu-toggle" class="header__main__label">
                <span class="header__main__label__burger"> </span>
                <span class="header__main__label__burger"> </span>
                <span class="header__main__label__burger"> </span>
            </label>
            <div class="header__main__overlay">
                <nav class="header__main__overlay__menu">
                    <h2 class="hidden">Burger Menu</h2>
                    <ul class="header__main__overlay__menu__list">
                        <li class="header__main__overlay__menu__list__item">
                            <HeaderLink href="/" title="Accueil">Accueil</HeaderLink>
                        </li>
                        <li class="header__main__overlay__menu__list__item">
                            <HeaderLink href="/projets" title="Projets">Projets</HeaderLink>
                        </li>
                        <li class="header__main__overlay__menu__list__item">
                            <HeaderLink href="/apropos" title="A Propos">A Propos</HeaderLink>
                        </li>
                        <li class="header__main__overlay__menu__list__item">
                            <HeaderLink href="https://github.com/tom-cremer" title="Github - Tom Cremer" target="_blank"
                                        rel="noopener noreferrer">
                                Github
                            </HeaderLink>
                        </li>
                        <li class="header__main__overlay__menu__list__item">
                            <HeaderLink href="/#contact" title="Contact">Contact</HeaderLink>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</header>

<script>
    const menuToggle = document.getElementById("menu-toggle");
    const body = document.body;

    menuToggle.addEventListener("change", (event) => {
        body.classList.toggle("no-scroll");
    });
</script>