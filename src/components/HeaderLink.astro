---
import type { HTMLAttributes } from 'astro/types';
import { isActivePath } from '../i18n/utils';

type Props = HTMLAttributes<'a'>;

const { href, title, class: className, ...props } = Astro.props;
const isActive = typeof href === 'string' && isActivePath(Astro.url.pathname, href);
---

<a href={href} title={title} class={`link ${isActive ? 'link--active' : ''}`} {...props}>
	<slot />
</a>

