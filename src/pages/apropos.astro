---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <section class="about">
        <div class="wrapper wrapper--smaller about__wrapper">
            <div class="about__main">
                <div class="about__main__contentContainer">
                    <h2 class="about__main__contentContainer__title">
                        Un peu plus que du code&nbsp;!
                    </h2>
                </div>

                <div class="about__main__primary">
                    <div class="about__main__primary__imageContainer">
                        <img src="/src/assets/portfolio_me.jpg" alt="Photo de Tom Cremer à l'athlétisme"
                             class="about__main__primary__imageContainer__img">
                    </div>
                    <div class="about__main__primary__content">
                        <p>
                            Holà, moi c'est Tom, développeur back-end avec un goût pour les défis, que ce soit derrière
                            mon clavier ou sur
                            la piste d'athlétisme&nbsp;!
                        </p>
                        <p>
                            Je suppose que si vous êtes là, en train de lire ceci c'est que vous voulez en apprendre
                            plus sur moi&#x2026; Bande de coquins va&nbsp;&#128521;
                        </p>
                        <p>
                            Blague à part, ce qui me passionne dans le web c'est de pouvoir créer et sans aucune limite
                            des sites tout aussi incroyables visuellement que logiquement,
                            et surtout que ces sites soient accessibles partout et à n'importe quel moment c'est juste
                            magique&nbsp;!
                        </p>
                        <p>
                            Ma devise ? <i>“Les records sont faits pour être battus”</i> — Robert Downey Jr, alias Iron
                            Man.
                            Une phrase qui résume bien ma vision : toujours chercher à aller plus loin, à progresser, et
                            à repousser mes propres limites.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <section class="faq" aria-label="FAQ">
        <div class="wrapper wrapper--smaller faq__wrapper">
            <div class="faq__main">
                <h2 class="faq__main__title">FAQ</h2>

                <div class="faq__main__list" id="faqAccordion" data-multi="true">
                    <div class="faq__main__item">
                        <button class="faq__main__trigger" aria-expanded="false" aria-controls="panel-1" id="trigger-1">
                            Depuis combien de temps tu codes ?
                            <span class="faq__main__icon" aria-hidden="true">+</span>
                        </button>
                        <div class="faq__main__panel" id="panel-1" role="region" aria-labelledby="trigger-1" hidden>
                            <div class="faq__main__panel__inner">
                                <p>Je code depuis que j'ai 16 ans
                                    ({new Date().getFullYear() - new Date(2004, 3, 29).getFullYear()} ans actuellement),
                                    j'ai commencé avec arduino puis j'ai appris python
                                    ensuite j'ai découvert le web&#x2026;</p>
                            </div>
                        </div>
                    </div>

                    <div class="faq__main__item">
                        <button class="faq__main__trigger" aria-expanded="false" aria-controls="panel-2" id="trigger-2">
                            Que fais-tu quand tu ne codes pas ?
                            <span class="faq__main__icon" aria-hidden="true">+</span>
                        </button>
                        <div class="faq__main__panel" id="panel-2" role="region" aria-labelledby="trigger-2" hidden>
                            <div class="faq__main__panel__inner">
                                <p>
                                    J'ai deux principaux passe temps, l'athlétisme et les jeux vidéos - Décompresser sur
                                    la piste est essentiels après une journée de code&nbsp;!
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="faq__main__item">
                        <button class="faq__main__trigger" aria-expanded="false" aria-controls="panel-3" id="trigger-3">
                            Ton film préféré ?
                            <span class="faq__main__icon" aria-hidden="true">+</span>
                        </button>
                        <div class="faq__main__panel" id="panel-3" role="region" aria-labelledby="trigger-3" hidden>
                            <div class="faq__main__panel__inner">
                                <p>
                                    Ouf. Il y en a plein, mais si je dois en choisir qu'un ce serait, <em>The Wild
                                    Robot</em>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="faq__main__item">
                        <button class="faq__main__trigger" aria-expanded="false" aria-controls="panel-4" id="trigger-4">
                            Team Café ou Thé&nbsp;?
                            <span class="faq__main__icon" aria-hidden="true">+</span>
                        </button>
                        <div class="faq__main__panel" id="panel-4" role="region" aria-labelledby="trigger-4" hidden>
                            <div class="faq__main__panel__inner">
                                <p>
                                    Team Thé, avec deux petits carrés de sucre ou si j'ai le choix une bonne cuillère de
                                    miel
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="faq__main__item">
                        <button class="faq__main__trigger" aria-expanded="false" aria-controls="panel-5" id="trigger-5">
                            Quel sont tes trois jeux du moment&nbsp;?
                            <span class="faq__main__icon" aria-hidden="true">+</span>
                        </button>
                        <div class="faq__main__panel" id="panel-5" role="region" aria-labelledby="trigger-5" hidden>
                            <div class="faq__main__panel__inner">
                                <p>
                                    En ce moment, je joue principalement à Cult of the Lamb, Elite: Dangerous et
                                    évidemment Hollow Knight: Silksong
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="faq__main__item">
                        <button class="faq__main__trigger" aria-expanded="false" aria-controls="panel-6" id="trigger-6">
                            Front-end ou Back-end&nbsp;? (Et pourquoi&nbsp;?)
                            <span class="faq__main__icon" aria-hidden="true">+</span>
                        </button>
                        <div class="faq__main__panel" id="panel-6" role="region" aria-labelledby="trigger-6" hidden>
                            <div class="faq__main__panel__inner">
                                <p>
                                    Le but serait de faire Full-stack, mais à choisir je penche plus sur le Back-end,
                                    pourquoi, parce que j'aime bien me creuser la tête, de plus j'aime la logique&nbsp;!
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="faq__main__item">
                        <button class="faq__main__trigger" aria-expanded="false" aria-controls="panel-7" id="trigger-7">
                            Ton éditeur de code préféré ?
                            <span class="faq__main__icon" aria-hidden="true">+</span>
                        </button>
                        <div class="faq__main__panel" id="panel-7" role="region" aria-labelledby="trigger-7" hidden>
                            <div class="faq__main__panel__inner">
                                <p>
                                    <em>PHPStorm</em>&nbsp;! Il n'y a pas de débat, il y a tout, c'est une mine d'outils, {new Date().getFullYear() - new Date(2022, 9, 15).getFullYear()} ans que je l'utilise et je n'ai pas encore fini d'en apprendre sur lui&nbsp;!
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const accordion = document.getElementById("faqAccordion");
            if (!accordion) return;

            const multi = accordion.getAttribute("data-multi") === "true";
            const items = Array.from(accordion.querySelectorAll(".faq__main__item"));


            function closePanel(trigger, panel) {
                trigger.setAttribute("aria-expanded", "false");
                // animate height to 0
                panel.style.height = panel.scrollHeight + "px"; // set current for transition
                requestAnimationFrame(() => {
                    panel.style.transition = "height 260ms ease";
                    panel.style.height = "0px";
                });

                // after transition, hide and cleanup
                panel.addEventListener("transitionend", function handler() {
                    panel.hidden = true;
                    panel.style.removeProperty("height");
                    panel.style.removeProperty("transition");
                    panel.removeEventListener("transitionend", handler);
                });
            }

            // helper : open a panel (animated)
            function openPanel(trigger, panel) {
                // if single-open, close others
                if (!multi) {
                    items.forEach(i => {
                        const t = i.querySelector(".faq__main__trigger");
                        const p = i.querySelector(".faq__main__panel");
                        if (p !== panel && t.getAttribute("aria-expanded") === "true") {
                            closePanel(t, p);
                        }
                    });
                }

                trigger.setAttribute("aria-expanded", "true");
                panel.hidden = false;

                // measure then animate to that height
                const height = panel.scrollHeight;
                panel.style.height = "0px";
                requestAnimationFrame(() => {
                    panel.style.transition = "height 260ms ease";
                    panel.style.height = height + "px";
                });

                panel.addEventListener("transitionend", function handler() {
                    // cleanup so content can be responsive
                    panel.style.removeProperty("height");
                    panel.style.removeProperty("transition");
                    panel.removeEventListener("transitionend", handler);
                });
            }

            // toggle
            items.forEach(item => {
                const trigger = item.querySelector(".faq__main__trigger");
                const panel = item.querySelector(".faq__main__panel");

                // ensure initial state sync
                if (trigger.getAttribute("aria-expanded") === "true") {
                    panel.hidden = false;
                    panel.style.removeProperty("height");
                } else {
                    panel.hidden = true;
                }

                // click
                trigger.addEventListener("click", () => {
                    const expanded = trigger.getAttribute("aria-expanded") === "true";
                    if (expanded) {
                        closePanel(trigger, panel);
                    } else {
                        openPanel(trigger, panel);
                    }
                });

                // keyboard accessibility
                trigger.addEventListener("keydown", (e) => {
                    const KEY = {
                        ENTER: "Enter",
                        SPACE: " ",
                        ARROW_UP: "ArrowUp",
                        ARROW_DOWN: "ArrowDown",
                        HOME: "Home",
                        END: "End",
                    };

                    switch (e.key) {
                        case KEY.ENTER:
                        case KEY.SPACE:
                            e.preventDefault();
                            trigger.click();
                            break;

                        case KEY.ARROW_DOWN: {
                            e.preventDefault();
                            // focus next trigger (wrap)
                            const idx = items.indexOf(item);
                            const next = items[(idx + 1) % items.length].querySelector(".faq__main__trigger");
                            next.focus();
                            break;
                        }

                        case KEY.ARROW_UP: {
                            e.preventDefault();
                            const idx = items.indexOf(item);
                            const prev = items[(idx - 1 + items.length) % items.length].querySelector(".faq__main__trigger");
                            prev.focus();
                            break;
                        }

                        case KEY.HOME:
                            e.preventDefault();
                            items[0].querySelector(".faq__main__trigger").focus();
                            break;

                        case KEY.END:
                            e.preventDefault();
                            items[items.length - 1].querySelector(".faq__main__trigger").focus();
                            break;

                        default:
                            break;
                    }
                });
            });
        });
    </script>

</Layout>