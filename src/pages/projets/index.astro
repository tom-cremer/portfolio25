---
import Layout from '../../layouts/Layout.astro';
import {getCollection} from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Tag from "../../components/Tag.astro";
import {Image} from "astro:assets";

const posts = (await getCollection('projets')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).reverse();
---

<Layout>
    <section class="projects">
        <div class="wrapper wrapper--small2 projects__wrapper">
            <div class="projects__main">
                <div class="projects__main__primary">
                    <h2 class="projects__main__primary__title">
                        Mes Projets
                    </h2>
                </div>
                <div class="projects__main__secondary">
                    <div class="projects__main__secondary__gridContainer">
                        <div class="projects__main__secondary__gridContainer__grid">
                            {posts.map((post) => (
                                    <a href={`/projets/${post.id}`} title={post.data.title} class="card-project">
                                        <div class="card-project__contentContainer">
                                            <h3 class="card-project__contentContainer__title">
                                                {post.data.title}
                                            </h3>
                                            <Tag tag={post.data.tag}/>
                                        </div>
                                        <div class="card-project__imageContainer">
                                            <Image class="card-project__imageContainer__img"
                                                   src={post.data.heroImage}
                                                   alt={`Illustration du projet ${post.data.title}`}
                                                   width="100%"
                                                   height="100%"/>
                                        </div>
                                        <div class="card-project__buttonContainer">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                 viewBox="0 0 24 24">
                                                <path d="M18 8L22 12L18 16"/>
                                                <path d="M2 12H22"/>
                                            </svg>
                                        </div>
                                    </a>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

