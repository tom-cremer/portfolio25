---
import Layout from "../layouts/Layout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import {interpolate, useTranslations} from '../i18n/utils';
import type {Lang} from '../i18n/ui';
import {faq, faqVars as getFaqVars} from '../data/faq';
import {localize} from '../data/l10n';

interface Props {
    lang: Lang;
}

const {lang} = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const faqVars = getFaqVars();
const faqItems = faq.map((item) => ({q: localize(item.q, lang), a: interpolate(localize(item.a, lang), faqVars)}));
const stripHtml = (html: string) => html.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, '\u00a0');
const faqJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {'@type': 'Answer', text: stripHtml(item.a)},
    })),
};
---

<Layout title={t('meta.about.title')} description={t('meta.about.description')} jsonLd={faqJsonLd}>
    <section class="about">
        <div class="wrapper wrapper--smaller about__wrapper">
            <div class="about__main">
                <div class="about__main__contentContainer">
                    <h1 class="about__main__contentContainer__title">
                        {t('about.title')}
                    </h1>
                </div>

                <div class="about__main__primary">
                    <div class="about__main__primary__imageContainer">
                        <img src="/assets/portfolio_me.jpg" alt={t('about.photoAlt')}
                             class="about__main__primary__imageContainer__img">
                    </div>
                    <div class="about__main__primary__content">
                        <p>{t('about.p1')}</p>
                        <p>{t('about.p2')}</p>
                        <p>{t('about.p3')}</p>
                        <p set:html={t('about.p4Html')}/>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <section class="faq" id="faq" aria-label="FAQ">
        <div class="wrapper wrapper--smaller faq__wrapper">
            <div class="faq__main">
                <h2 class="faq__main__title">{t('about.faq.title')}</h2>

                <FaqAccordion items={faqItems} id="faq-about"/>
            </div>
        </div>
    </section>

</Layout>