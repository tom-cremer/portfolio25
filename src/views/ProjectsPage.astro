---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {useTranslations, localizePath} from '../i18n/utils';
import {getLocalizedEntries} from '../i18n/content';
import {byNewest} from '../i18n/localize';
import type {Lang} from '../i18n/ui';

interface Props {
    lang: Lang;
}

const {lang} = Astro.props;
const t = useTranslations(lang);
const projects = byNewest(await getLocalizedEntries('projets', lang));
---

<Layout title={t('meta.projects.title')} description={t('meta.projects.description')}>
    <section class="projects">
        <div class="wrapper wrapper--small2 projects__wrapper">
            <div class="projects__main">
                <div class="projects__main__primary">
                    <h1 class="projects__main__primary__title">
                        {t('projects.title')}
                    </h1>
                </div>
                <div class="projects__main__secondary">
                    <div class="projects__main__secondary__gridContainer">
                        <div class="projects__main__secondary__gridContainer__grid">
                            {projects.map((item) => (
                                    <ProjectCard lang={lang} item={item}/>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

